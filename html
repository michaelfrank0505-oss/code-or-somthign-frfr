<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Web Viewer: Games & Movies</title>
    <style>
        :root {
            --accent: #FF42A5; /* From your TikTok code */
            --bg: #0f0f0f;
            --nav-bg: #1a1a1a;
        }

        body, html {
            margin: 0;
            padding: 0;
            height: 100%;
            background-color: var(--bg);
            color: white;
            font-family: 'Segoe UI', sans-serif;
            overflow: hidden;
        }

        /* Top Navigation Bar */
        nav {
            display: flex;
            align-items: center;
            background: var(--nav-bg);
            padding: 10px 20px;
            height: 60px;
            box-sizing: border-box;
            border-bottom: 2px solid var(--accent);
            gap: 10px;
        }

        .logo {
            font-weight: bold;
            color: var(--accent);
            margin-right: 20px;
            font-size: 1.2rem;
        }

        .nav-btn {
            background: #333;
            border: none;
            color: white;
            padding: 8px 15px;
            border-radius: 5px;
            cursor: pointer;
            transition: 0.2s;
            font-size: 14px;
        }

        .nav-btn:hover {
            background: var(--accent);
        }

        .nav-btn.active {
            background: var(--accent);
            box-shadow: 0 0 10px var(--accent);
        }

        /* The Frame Container */
        #content-area {
            width: 100%;
            height: calc(100vh - 60px);
            background: #000;
        }

        iframe {
            width: 100%;
            height: 100%;
            border: none;
        }

        /* Fullscreen Toggle */
        .fs-btn {
            margin-left: auto;
            background: transparent;
            border: 1px solid #555;
            color: #aaa;
        }
    </style>
</head>
<body>

<nav>
    <div class="logo">HUB-VIEW</div>
    
    <button class="nav-btn active" onclick="setView(this, 'https://yflix.to/home')">yFlix</button>
    <button class="nav-btn" onclick="setView(this, 'https://1movieshd.com')">1Movies</button>
    <button class="nav-btn" onclick="setView(this, 'https://gn-math.dev')">GN-Math Games</button>
    
    <button class="nav-btn fs-btn" onclick="toggleFullScreen()">Fullscreen</button>
</nav>

<div id="content-area">
    <iframe 
        id="main-frame" 
        src="https://yflix.to/home" 
        allow="autoplay; fullscreen; encrypted-media" 
        sandbox="allow-forms allow-pointer-lock allow-same-origin allow-scripts allow-top-navigation">
    </iframe>
</div>

<script>
    function setView(btn, url) {
        // Update Iframe
        document.getElementById('main-frame').src = url;

        // Update Active Button UI
        document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
    }

    function toggleFullScreen() {
        if (!document.fullscreenElement) {
            document.documentElement.requestFullscreen();
        } else {
            if (document.exitFullscreen) {
                document.exitFullscreen();
            }
        }
    }
</script>

</body>
</html>
